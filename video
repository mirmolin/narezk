    function playSegment(segId) {
      const seg = state.segments.find(s => s.id === segId);
      if (!seg) return;

      state.activeSegmentId = seg.id;
      state.segmentStopAt = seg.end;
      el.mainVideo.currentTime = seg.start;
      el.mainVideo.play().catch(() => {});

      renderTimeline();
      renderSegmentsList();
      updateActiveSegmentUI();
    }

    // Клик по пустому месту таймлайна перематывает видео
    el.timelineContainer.addEventListener('click', (e) => {
      if (!state.duration) return;
      const rect = el.timelineContainer.getBoundingClientRect();
      const ratio = Math.max(0, Math.min(1, (e.clientX - rect.left) / rect.width));
      el.mainVideo.currentTime = ratio * state.duration;
      state.segmentStopAt = null;
    });

    // Синхронизация плеера с таймлайном и автоостановка в конце фрагмента
    el.mainVideo.addEventListener('timeupdate', () => {
      const curr = el.mainVideo.currentTime;
      const dur = state.duration || 1;

      el.currentTimeDisplay.textContent = `${formatTime(curr)} / ${formatTime(dur)}`;
      el.timelinePlayhead.style.left = `${Math.min(100, (curr / dur) * 100)}%`;

      // Автоостановка при достижении конца выбранного фрагмента
      if (state.segmentStopAt !== null && el.chkAutoStop.checked && curr >= state.segmentStopAt) {
        el.mainVideo.pause();
        state.segmentStopAt = null;
      }

      // Автоматически подсвечиваем сегмент, в котором сейчас находится курсор
      const found = state.segments.find(s => curr >= s.start && curr < s.end);
      const foundId = found ? found.id : null;
      if (foundId !== state.activeSegmentId) {
        state.activeSegmentId = foundId;
        renderTimeline();
        renderSegmentsList();
        updateActiveSegmentUI();
      }
    });

