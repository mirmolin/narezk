    function renderTimeline() {
      el.timelineSegmentsLayer.innerHTML = '';
      if (state.segments.length === 0 || !state.duration) {
        el.timelineEmptyHint.classList.remove('hidden');
        return;
      }

      el.timelineEmptyHint.classList.add('hidden');
      const dur = state.duration;

      state.segments.forEach((seg) => {
        const color = SEGMENT_COLORS[seg.colorIdx % SEGMENT_COLORS.length];
        const leftPct = (seg.start / dur) * 100;
        const widthPct = Math.max(0.8, ((seg.end - seg.start) / dur) * 100);
        const isActive = seg.id === state.activeSegmentId;

        const bar = document.createElement('div');
        bar.className = `absolute top-1.5 bottom-1.5 rounded-md transition-all duration-150 cursor-pointer border ${isActive ? 'z-10 brightness-125 ring-2 ring-white/80' : 'hover:brightness-125'}`;
        bar.style.left = `${leftPct}%`;
        bar.style.width = `calc(${widthPct}% - 2px)`;
        bar.style.backgroundColor = color.bg;
        bar.style.borderColor = color.hex;

        // Внутренняя подпись, если блок достаточно широкий
        if (widthPct > 9) {
          bar.innerHTML = `<div class="px-1.5 h-full flex items-center text-[10px] font-semibold text-white truncate drop-shadow">${escapeHtml(seg.title)}</div>`;
        }

        bar.addEventListener('click', (e) => {
          e.stopPropagation();
          playSegment(seg.id);
        });

        bar.addEventListener('mouseenter', (e) => {
          el.tooltipTitle.textContent = seg.title;
          el.tooltipTime.textContent = `${formatTime(seg.start)} — ${formatTime(seg.end)} (${formatTime(seg.end - seg.start)})`;
          el.timelineTooltip.classList.remove('hidden');
          const rect = el.timelineContainer.getBoundingClientRect();
          const barRect = bar.getBoundingClientRect();
          const centerX = barRect.left - rect.left + barRect.width / 2;
          el.timelineTooltip.style.left = `${Math.max(70, Math.min(rect.width - 70, centerX))}px`;
        });

        bar.addEventListener('mouseleave', () => {
          el.timelineTooltip.classList.add('hidden');
        });

        el.timelineSegmentsLayer.appendChild(bar);
      });
    }

    function renderSegmentsList() {
      // Очищаем список, сохраняя emptyState
      Array.from(el.segmentsList.children).forEach(child => {
        if (child !== el.segmentsEmptyState) child.remove();
      });

      if (state.segments.length === 0) {
        el.segmentsEmptyState.classList.remove('hidden');
