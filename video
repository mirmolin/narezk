<!DOCTYPE html>
<html lang="ru" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>ClipMind AI — Умная нарезка видео и улучшение фото</title>

  <!-- Шрифт Inter -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', 'system-ui', 'sans-serif'],
          },
          colors: {
            studio: {
              950: '#07070a',
              900: '#0f1016',
              800: '#171923',
              700: '#232635',
            }
          }
        }
      }
    };
  </script>

  <style>
    /* Базовые стили и скроллбар для тёмной студийной темы */
    body {
      background-color: #07070a;
      color: #f4f4f5;
      font-family: 'Inter', system-ui, sans-serif;
      overflow-x: hidden;
    }

    /* Фоновое свечение */
    .ambient-bg {
      background-image:
        radial-gradient(ellipse 60% 40% at 15% 0%, rgba(99, 102, 241, 0.16), transparent 70%),
        radial-gradient(ellipse 50% 35% at 85% 5%, rgba(20, 184, 166, 0.12), transparent 70%);
    }

    /* Стеклянные панели */
    .glass-panel {
      background: rgba(15, 16, 22, 0.78);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid rgba(255, 255, 255, 0.08);
    }

    /* Кастомный скроллбар */
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: rgba(255, 255, 255, 0.03);
    }
    ::-webkit-scrollbar-thumb {
      background: rgba(255, 255, 255, 0.14);
      border-radius: 9999px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: rgba(255, 255, 255, 0.25);
    }

    /* Анимация перетаскивания файла */
    .drop-active {
      border-color: #6366f1 !important;
      background-color: rgba(99, 102, 241, 0.1) !important;
      transform: scale(1.005);
    }

    /* Анимация тостов */
    @keyframes slideInToast {
      from {
        opacity: 0;
        transform: translateY(12px) scale(0.96);
      }
      to {
        opacity: 1;
        transform: translateY(0) scale(1);
      }
    }
    .toast-enter {
      animation: slideInToast 0.25s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    /* Шахматный фон для просмотра фото */
    .checker-bg {
      background-color: #0b0c12;
      background-image:
        linear-gradient(45deg, rgba(255,255,255,0.03) 25%, transparent 25%),
        linear-gradient(-45deg, rgba(255,255,255,0.03) 25%, transparent 25%),
        linear-gradient(45deg, transparent 75%, rgba(255,255,255,0.03) 75%),
        linear-gradient(-45deg, transparent 75%, rgba(255,255,255,0.03) 75%);
      background-size: 20px 20px;
      background-position: 0 0, 0 10px, 10px -10px, -10px 0px;
    }

    /* Кастомные ползунки студийной коррекции */
    input[type="range"].studio-slider {
      -webkit-appearance: none;
      appearance: none;
      height: 5px;
      border-radius: 9999px;
      background: rgba(255, 255, 255, 0.12);
      outline: none;
    }
    input[type="range"].studio-slider::-webkit-slider-thumb {
      -webkit-appearance: none;
      appearance: none;
      width: 15px;
      height: 15px;
      border-radius: 9999px;
      background: #818cf8;
      border: 2px solid #ffffff;
      box-shadow: 0 0 10px rgba(99, 102, 241, 0.6);
      cursor: pointer;
      transition: transform 0.12s ease;
    }
    input[type="range"].studio-slider::-webkit-slider-thumb:hover {
      transform: scale(1.15);
    }
  </style>
</head>
<body class="min-h-screen ambient-bg flex flex-col selection:bg-indigo-500/30 selection:text-indigo-200">

  <!-- ==================== ШАПКА САЙТА ==================== -->
  <header class="sticky top-0 z-40 border-b border-white/8 bg-studio-950/80 backdrop-blur-xl">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 min-h-16 py-2 sm:py-0 flex flex-wrap items-center justify-between gap-3">
      <!-- Логотип -->
      <div class="flex items-center gap-3">
        <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-indigo-500 to-teal-400 p-[1px] shadow-lg shadow-indigo-500/20">
          <div class="w-full h-full rounded-[11px] bg-studio-950 flex items-center justify-center">
            <svg class="w-5 h-5 text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
        </div>
        <div>
          <div class="flex items-center gap-2">
            <h1 class="text-base sm:text-lg font-bold tracking-tight text-white">ClipMind <span class="text-indigo-400">AI</span></h1>
            <span class="hidden md:inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold uppercase tracking-wider bg-indigo-500/15 text-indigo-300 border border-indigo-500/30">Gemini Vision</span>
          </div>
          <p class="text-[11px] text-zinc-400 hidden sm:block">Умная нарезка видео и улучшение фото</p>
        </div>
      </div>

      <!-- Переключатель рабочих пространств (вкладок) -->
      <nav class="flex items-center p-1 rounded-xl bg-studio-900/90 border border-white/10 order-3 sm:order-2 w-full sm:w-auto justify-center" aria-label="Рабочие пространства">
        <button type="button" id="tabVideoBtn" data-tab="video" class="workspace-tab flex-1 sm:flex-none inline-flex items-center justify-center gap-2 px-3.5 py-1.5 rounded-lg text-xs sm:text-sm font-semibold transition-all cursor-pointer bg-indigo-600 text-white shadow-md shadow-indigo-500/25">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />
          </svg>
          <span>Нарезка видео</span>
        </button>
        <button type="button" id="tabPhotoBtn" data-tab="photo" class="workspace-tab flex-1 sm:flex-none inline-flex items-center justify-center gap-2 px-3.5 py-1.5 rounded-lg text-xs sm:text-sm font-semibold transition-all cursor-pointer text-zinc-400 hover:text-white">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
          </svg>
          <span>Улучшение фото</span>
        </button>
      </nav>

      <!-- Кнопки действий в шапке для видео (видны после загрузки видео) -->
      <div id="headerActions" class="hidden flex items-center gap-2 sm:gap-2.5 order-2 sm:order-3">
        <button id="btnChangeVideo" class="inline-flex items-center gap-2 px-3 py-2 rounded-xl text-xs sm:text-sm font-medium text-zinc-300 hover:text-white bg-white/5 hover:bg-white/10 border border-white/10 transition-all cursor-pointer">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" />
          </svg>
          <span class="hidden md:inline">Другое видео</span>
        </button>

        <button id="btnExportYouTube" disabled class="inline-flex items-center gap-2 px-3 py-2 rounded-xl text-xs sm:text-sm font-medium text-teal-300 hover:text-teal-200 bg-teal-500/10 hover:bg-teal-500/20 border border-teal-500/25 disabled:opacity-40 disabled:cursor-not-allowed transition-all cursor-pointer">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3" />
          </svg>
          <span class="hidden sm:inline">Таймкоды YouTube</span>
        </button>

        <button id="btnExportJSON" disabled class="inline-flex items-center gap-2 px-3 py-2 rounded-xl text-xs sm:text-sm font-medium text-indigo-300 hover:text-indigo-200 bg-indigo-500/10 hover:bg-indigo-500/20 border border-indigo-500/25 disabled:opacity-40 disabled:cursor-not-allowed transition-all cursor-pointer">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          <span class="hidden sm:inline">Скачать JSON</span>
        </button>
      </div>

      <!-- Кнопки действий в шапке для фото (видны после загрузки фото) -->
      <div id="photoHeaderActions" class="hidden flex items-center gap-2 sm:gap-2.5 order-2 sm:order-3">
        <button id="btnChangePhoto" class="inline-flex items-center gap-2 px-3 py-2 rounded-xl text-xs sm:text-sm font-medium text-zinc-300 hover:text-white bg-white/5 hover:bg-white/10 border border-white/10 transition-all cursor-pointer">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" />
          </svg>
          <span class="hidden md:inline">Другое фото</span>
        </button>
        <button id="btnQuickDownloadPhoto" class="inline-flex items-center gap-2 px-3 py-2 rounded-xl text-xs sm:text-sm font-medium text-white bg-gradient-to-r from-indigo-600 to-purple-600 hover:from-indigo-500 hover:to-purple-500 shadow-md shadow-indigo-500/20 transition-all cursor-pointer">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
          </svg>
          <span class="hidden sm:inline">Скачать фото</span>
        </button>
      </div>
    </div>
  </header>

  <!-- ==================== ОСНОВНОЙ КОНТЕНТ ==================== -->
  <main class="flex-1 w-full max-w-7xl mx-auto px-4 sm:px-6 py-6 sm:py-8">

    <!-- Скрытые input для выбора файлов -->
    <input type="file" id="fileInput" accept="video/*" class="hidden" />
    <input type="file" id="photoFileInput" accept="image/jpeg,image/png,image/webp,image/*" class="hidden" />

    <!-- ЭКРАН 1: ЗОНА ЗАГРУЗКИ ВИДЕО -->
    <section id="uploadSection" class="max-w-3xl mx-auto py-8 sm:py-16">
      <div class="text-center mb-8 sm:mb-10">
        <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-medium bg-white/5 border border-white/10 text-zinc-300 mb-4">
          <span class="w-2 h-2 rounded-full bg-teal-400 animate-pulse"></span>
          Анализ и нарезка прямо в вашем браузере
        </span>
        <h2 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-white mb-4 leading-tight">
          Нарезайте любые видео на <span class="text-transparent bg-clip-text bg-gradient-to-r from-indigo-400 via-purple-400 to-teal-300">смысловые части</span>
        </h2>
        <p class="text-sm sm:text-base text-zinc-400 max-w-xl mx-auto leading-relaxed">
          Загрузите лекцию, подкаст, интервью или влог. Искусственный интеллект определит смену тем, создаст интерактивный таймлайн и позволит скачать каждый фрагмент отдельно.
        </p>
      </div>

      <!-- Зона Drag & Drop -->
      <div id="dropZone" class="glass-panel rounded-3xl p-8 sm:p-14 border-2 border-dashed border-white/15 hover:border-indigo-500/60 transition-all duration-200 text-center cursor-pointer group">
        <div class="w-16 h-16 sm:w-20 sm:h-20 mx-auto mb-5 rounded-2xl bg-indigo-500/10 border border-indigo-500/25 flex items-center justify-center group-hover:scale-105 group-hover:bg-indigo-500/20 transition-all">
          <svg class="w-8 h-8 sm:w-10 sm:h-10 text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6">
            <path stroke-linecap="round" stroke-linejoin="round" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
          </svg>
        </div>

        <h3 class="text-lg sm:text-xl font-semibold text-white mb-2">Перетащите видеофайл сюда</h3>
        <p class="text-xs sm:text-sm text-zinc-400 mb-6">Поддерживаются MP4, WebM, MOV, MKV и другие форматы браузера</p>

        <button type="button" id="btnSelectFile" class="inline-flex items-center gap-2 px-6 py-3 rounded-xl font-semibold text-sm text-white bg-gradient-to-r from-indigo-600 to-indigo-500 hover:from-indigo-500 hover:to-indigo-400 shadow-lg shadow-indigo-500/25 transition-all cursor-pointer">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />
          </svg>
          Выбрать видеофайл
        </button>
      </div>

      <!-- Карточки преимуществ -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mt-8">
        <div class="glass-panel rounded-2xl p-4">
          <div class="w-8 h-8 rounded-lg bg-indigo-500/15 text-indigo-400 flex items-center justify-center mb-2.5">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
          </div>
          <h4 class="text-sm font-semibold text-white mb-1">Умный поиск сцен</h4>
          <p class="text-xs text-zinc-400">Автоматическое определение смены тем, слайдов и ключевых моментов.</p>
        </div>
        <div class="glass-panel rounded-2xl p-4">
          <div class="w-8 h-8 rounded-lg bg-teal-500/15 text-teal-400 flex items-center justify-center mb-2.5">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h7"/></svg>
          </div>
          <h4 class="text-sm font-semibold text-white mb-1">Цветной таймлайн</h4>
          <p class="text-xs text-zinc-400">Мгновенная навигация, редактирование границ и добавление своих глав.</p>
        </div>
        <div class="glass-panel rounded-2xl p-4">
          <div class="w-8 h-8 rounded-lg bg-purple-500/15 text-purple-400 flex items-center justify-center mb-2.5">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
          </div>
          <h4 class="text-sm font-semibold text-white mb-1">Экспорт фрагментов</h4>
          <p class="text-xs text-zinc-400">Скачивание отдельных отрезков со звуком, таймкодов YouTube и JSON.</p>
        </div>
      </div>
    </section>

    <!-- ЭКРАН 2: РАБОЧАЯ СТУДИЯ -->
    <section id="workspaceSection" class="hidden grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">

      <!-- ЛЕВАЯ КОЛОНКА: Плеер, таймлайн и ИИ-панель -->
      <div class="lg:col-span-7 xl:col-span-8 space-y-5">

        <!-- Метаданные видео -->
        <div class="glass-panel rounded-2xl px-4 py-3 flex flex-wrap items-center justify-between gap-3">
          <div class="flex items-center gap-3 min-w-0">
            <div class="w-9 h-9 rounded-xl bg-indigo-500/15 border border-indigo-500/25 flex items-center justify-center shrink-0">
              <svg class="w-4 h-4 text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M7 4v16M17 4v16M3 8h4m10 0h4M3 12h18M3 16h4m10 0h4M4 20h16a1 1 0 001-1V5a1 1 0 00-1-1H4a1 1 0 00-1 1v14a1 1 0 001 1z" />
              </svg>
            </div>
            <div class="min-w-0">
              <p id="metaFileName" class="text-sm font-semibold text-white truncate">video.mp4</p>
              <div class="flex flex-wrap items-center gap-x-3 gap-y-0.5 text-xs text-zinc-400">
                <span id="metaDuration">00:00</span>
                <span>•</span>
                <span id="metaResolution">—</span>
                <span>•</span>
                <span id="metaFileSize">—</span>
              </div>
            </div>
          </div>

          <div id="activeSegmentBadge" class="hidden inline-flex items-center gap-2 px-3 py-1.5 rounded-xl bg-white/5 border border-white/10 text-xs max-w-full">
            <span id="activeSegmentDot" class="w-2.5 h-2.5 rounded-full shrink-0 bg-indigo-400"></span>
            <span id="activeSegmentTitle" class="text-zinc-200 font-medium truncate max-w-[200px] sm:max-w-[260px]">—</span>
          </div>
        </div>

        <!-- Видеоплеер и интерактивный цветной таймлайн -->
        <div class="glass-panel rounded-2xl overflow-hidden shadow-2xl">
          <!-- Контейнер видео -->
          <div class="relative bg-black aspect-video flex items-center justify-center">
            <video id="mainVideo" controls playsinline class="w-full h-full max-h-[60vh] object-contain"></video>
          </div>

          <!-- Панель интерактивного таймлайна -->
          <div class="p-4 sm:p-5 border-t border-white/8 bg-studio-900/70 space-y-3">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <div class="flex items-center gap-2.5">
                <span class="text-xs font-semibold uppercase tracking-wider text-zinc-400">Смысловой таймлайн</span>
                <span id="currentTimeDisplay" class="font-mono text-xs text-zinc-300 bg-white/5 px-2 py-0.5 rounded-md border border-white/8">00:00 / 00:00</span>
              </div>

              <div class="flex flex-wrap items-center gap-3">
                <!-- Кнопка переноса текущего кадра видео в студию улучшения фото -->
                <button type="button" id="btnEnhanceVideoFrame" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold text-purple-200 bg-purple-500/15 hover:bg-purple-500/25 border border-purple-500/35 transition-all cursor-pointer">
                  <svg class="w-3.5 h-3.5 text-purple-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
                  </svg>
                  Улучшить текущий кадр
                </button>

                <!-- Переключатель автоостановки в конце сегмента -->
                <label class="inline-flex items-center gap-2 text-xs text-zinc-300 cursor-pointer select-none">
                  <input type="checkbox" id="chkAutoStop" checked class="w-3.5 h-3.5 rounded accent-indigo-500 cursor-pointer" />
                  <span>Автоостановка в конце фрагмента</span>
                </label>
              </div>
            </div>

            <!-- Дорожка таймлайна -->
            <div class="relative pt-1 pb-1">
              <div id="timelineContainer" class="relative h-11 w-full rounded-xl bg-studio-950 border border-white/10 overflow-hidden cursor-pointer select-none">
                <!-- Подсказка, когда сегментов ещё нет -->
                <div id="timelineEmptyHint" class="absolute inset-0 flex items-center justify-center text-xs text-zinc-500 pointer-events-none px-3 text-center">
                  Запустите ИИ-анализ ниже или добавьте фрагмент вручную, чтобы увидеть цветную разметку
                </div>

                <!-- Слой цветных сегментов -->
                <div id="timelineSegmentsLayer" class="absolute inset-0"></div>

                <!-- Курсор текущего времени (Playhead) -->
                <div id="timelinePlayhead" class="absolute top-0 bottom-0 w-0.5 bg-white shadow-[0_0_10px_rgba(255,255,255,0.9)] pointer-events-none z-20" style="left: 0%;">
                  <div class="w-2.5 h-2.5 rounded-full bg-white -ml-[4px] -mt-0.5 shadow"></div>
                </div>
