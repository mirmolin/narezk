    /**
     * Равномерно извлекает заданное число ключевых кадров из видео через скрытый <canvas>.
     */
    async function extractKeyframes(frameCount, onProgress) {
      const video = document.createElement('video');
      video.src = state.videoUrl;
      video.muted = true;
      video.playsInline = true;
      video.crossOrigin = 'anonymous';

      await new Promise((resolve, reject) => {
        video.onloadedmetadata = resolve;
        video.onerror = () => reject(new Error('Не удалось загрузить видео для извлечения кадров'));
      });

      const dur = video.duration || state.duration;
      const maxWidth = 512;
      const scale = Math.min(1, maxWidth / (video.videoWidth || 640));
      const canvas = document.createElement('canvas');
      canvas.width = Math.max(160, Math.round((video.videoWidth || 640) * scale));
      canvas.height = Math.max(90, Math.round((video.videoHeight || 360) * scale));
      const ctx = canvas.getContext('2d');

      const frames = [];
      const count = Math.max(4, Math.min(frameCount, Math.ceil(dur)));

      for (let i = 0; i < count; i++) {
        // Равномерно распределяем точки от начала до конца видео
        const ratio = count === 1 ? 0 : i / (count - 1);
        const timeSec = Math.min(Math.max(0.1, ratio * (dur - 0.2)), Math.max(0.1, dur - 0.1));

        await new Promise((resolve) => {
          const onSeeked = () => {
            video.removeEventListener('seeked', onSeeked);
            resolve();
          };
          video.addEventListener('seeked', onSeeked);
          video.currentTime = timeSec;
        });

        ctx.drawImage(video, 0, 0, canvas.width, canvas.height);
        const dataUrl = canvas.toDataURL('image/jpeg', 0.68);
        const base64 = dataUrl.split(',')[1];

        frames.push({
          timeSec: Number(timeSec.toFixed(1)),
          base64
        });

        if (onProgress) onProgress(i + 1, count);
      }

      video.src = '';
      video.remove();
      return frames;
    }

    /**
     * Запрос к Gemini API с экспоненциальной задержкой при временных ошибках/лимитах
     */
    async function callGeminiWithRetry(payload, maxRetries = 4) {
      const url = `https://generativelanguage.googleapis.com/v1beta/models/${GEMINI_MODEL}:generateContent?key=${apiKey}`;
      let delay = 1000;

      for (let attempt = 0; attempt <= maxRetries; attempt++) {
        try {
          const response = await fetch(url, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
          });

          if (response.ok) {
            return await response.json();
          }

          if ((response.status === 429 || response.status >= 500) && attempt < maxRetries) {
            await new Promise(r => setTimeout(r, delay));
            delay *= 2;
            continue;
          }

          const errText = await response.text();
          throw new Error(`Ошибка API (${response.status}): ${errText.slice(0, 180)}`);
        } catch (err) {
          if (attempt < maxRetries) {
            await new Promise(r => setTimeout(r, delay));
            delay *= 2;
            continue;
          }
          throw err;
        }
      }
    }

    function updateProgress(status, percent) {
      el.analysisStatusText.textContent = status;
      el.analysisPercentText.textContent = `${Math.round(percent)}%`;
      el.analysisProgressBar.style.width = `${Math.min(100, Math.max(0, percent))}%`;
    }

    /** Основная функция запуска ИИ-анализа */
    async function runAiAnalysis() {
      if (!state.file || state.isAnalyzing) return;

      state.isAnalyzing = true;
      el.btnAnalyze.disabled = true;
      el.analyzeBtnText.textContent = 'Идёт анализ...';
      el.analysisProgressBox.classList.remove('hidden');

      try {
        // Шаг 1: Извлечение 16 ключевых кадров
        const targetFrames = 16;
        updateProgress('Извлечение ключевых кадров...', 5);

        const frames = await extractKeyframes(targetFrames, (current, total) => {
          const pct = 5 + (current / total) * 45;
          updateProgress(`Извлечение кадров (${current}/${total})...`, pct);
        });

        // Шаг 2: Формирование запроса к Gemini API
        updateProgress('ИИ анализирует смысловые переходы...', 60);

        const modeInstructions = {
          scenes: 'Раздели всё видео от начала до конца на логические смысловые части по смене тем, локаций, слайдов или сцен. Сегменты должны последовательно покрывать всё видео без больших пропусков.',
          shorts: 'Найди самые интересные, динамичные, эмоциональные или полезные фрагменты видео, которые идеально подойдут для вертикальных роликов Shorts / Reels / TikTok (старайся делать их лаконичными и завершёнными по смыслу).',
          youtube: 'Создай идеальную структуру глав для YouTube, начиная строго с 0 секунд и до самого конца видео. Названия глав должны быть ёмкими, кликабельными и понятными зрителю.',
          custom: el.customPromptInput.value.trim() || 'Раздели видео на смысловые части.'
        };

        const systemInstructionText = `Ты — профессиональный режиссёр монтажа и ИИ-ассистент сервиса ClipMind AI.
Твоя задача — проанализировать последовательность ключевых кадров с точными таймкодами и разбить видео на смысловые сегменты.
Отвечай СТРОГО на русском языке (все заголовки, описания, категории и теги на русском).
Все значения start и end указывай в секундах (числа), строго в пределах от 0 до ${state.duration.toFixed(1)}.
Для каждого сегмента гарантируй, что end > start (минимум 2 секунды).`;

        const userParts = [
          {
            text: `Название файла: "${state.file.name}".
Общая длительность видео: ${state.duration.toFixed(1)} сек (${formatTime(state.duration)}).
Режим нарезки: ${modeInstructions[state.mode]}

Ниже представлены ${frames.length} ключевых кадров, равномерно извлечённых из видео с их точными таймкодами. Проанализируй визуальные переходы, текст на экране, смену планов и событий, и верни JSON-массив смысловых сегментов:`
          }
        ];

        frames.forEach(frame => {
          userParts.push({
            text: `[Таймкод: ${frame.timeSec} сек (${formatTime(frame.timeSec)})]`
          });
          userParts.push({
            inlineData: {
              mimeType: 'image/jpeg',
              data: frame.base64
            }
          });
        });

        const payload = {
          contents: [{ role: 'user', parts: userParts }],
          systemInstruction: { parts: [{ text: systemInstructionText }] },
          generationConfig: {
            responseMimeType: 'application/json',
            responseSchema: {
              type: 'ARRAY',
              items: {
                type: 'OBJECT',
                properties: {
                  title: { type: 'STRING', description: 'Короткое и понятное название смысловой части' },
                  start: { type: 'NUMBER', description: 'Время начала фрагмента в секундах' },
                  end: { type: 'NUMBER', description: 'Время окончания фрагмента в секундах' },
                  summary: { type: 'STRING', description: 'Краткое описание происходящего в этом фрагменте (1-2 предложения)' },
                  category: { type: 'STRING', description: 'Короткая категория сцены' },
                  tags: {
                    type: 'ARRAY',
                    items: { type: 'STRING' },
                    description: '2-3 коротких тега без #'
                  }
                },
                required: ['title', 'start', 'end', 'summary', 'category', 'tags']
              }
            }
          }
        };

        const result = await callGeminiWithRetry(payload);
        updateProgress('Обработка результатов...', 90);

        const rawText = result?.candidates?.[0]?.content?.parts?.[0]?.text;
        if (!rawText) {
          throw new Error('ИИ вернул пустой ответ. Попробуйте повторить анализ.');
        }

        const parsed = JSON.parse(rawText);
        if (!Array.isArray(parsed) || parsed.length === 0) {
          throw new Error('Не удалось выделить смысловые фрагменты.');
        }

        // Валидируем и нормализуем сегменты
        const dur = state.duration || 1;
        state.segments = parsed
          .map((item, idx) => {
            let start = Math.max(0, Math.min(dur - 0.5, Number(item.start) || 0));
            let end = Math.max(start + 0.5, Math.min(dur, Number(item.end) || dur));
            return {
              id: uid(),
              title: String(item.title || `Фрагмент ${idx + 1}`).trim(),
              start: Number(start.toFixed(1)),
              end: Number(end.toFixed(1)),
              summary: String(item.summary || '').trim(),
              category: String(item.category || 'Сцена').trim(),
              tags: Array.isArray(item.tags) ? item.tags.map(t => String(t).replace(/^#/, '').trim()).filter(Boolean).slice(0, 4) : [],
              colorIdx: idx % SEGMENT_COLORS.length
            };
          })
          .sort((a, b) => a.start - b.start);

        updateProgress('Готово!', 100);
        renderAll();
        showToast(`Найдено смысловых частей: ${state.segments.length}`, 'success');

        setTimeout(() => {
          el.analysisProgressBox.classList.add('hidden');
        }, 1200);

      } catch (err) {
        console.error(err);
        showToast(err.message || 'Ошибка при ИИ-анализе видео', 'error');
        el.analysisProgressBox.classList.add('hidden');
      } finally {
        state.isAnalyzing = false;
        el.btnAnalyze.disabled = false;
        el.analyzeBtnText.textContent = 'Анализировать и нарезать';
      }
    }

    el.btnAnalyze.addEventListener('click', runAiAnalysis);

    // ===================== ОТРИСОВКА ТАЙМЛАЙНА И КАРТОЧЕК =====================

    function renderAll() {
      const hasSegments = state.segments.length > 0;
      el.segmentsCountBadge.textContent = state.segments.length;
      el.btnExportYouTube.disabled = !hasSegments;
      el.btnExportJSON.disabled = !hasSegments;

