      rngPhotoQuality: document.getElementById('rngPhotoQuality'),
      valPhotoQuality: document.getElementById('valPhotoQuality'),
      btnDownloadEnhancedPhoto: document.getElementById('btnDownloadEnhancedPhoto'),
      btnDownloadPhotoText: document.getElementById('btnDownloadPhotoText')
    };

    /** Переключение между вкладками «Нарезка видео» и «Улучшение фото» */
    function switchWorkspaceTab(tab) {
      activeWorkspaceTab = tab;

      // Стили кнопок вкладок
      const isVideo = tab === 'video';
      photoEl.tabVideoBtn.className = `workspace-tab flex-1 sm:flex-none inline-flex items-center justify-center gap-2 px-3.5 py-1.5 rounded-lg text-xs sm:text-sm font-semibold transition-all cursor-pointer ${
        isVideo ? 'bg-indigo-600 text-white shadow-md shadow-indigo-500/25' : 'text-zinc-400 hover:text-white'
      }`;
      photoEl.tabPhotoBtn.className = `workspace-tab flex-1 sm:flex-none inline-flex items-center justify-center gap-2 px-3.5 py-1.5 rounded-lg text-xs sm:text-sm font-semibold transition-all cursor-pointer ${
        !isVideo ? 'bg-gradient-to-r from-indigo-600 to-purple-600 text-white shadow-md shadow-purple-500/25' : 'text-zinc-400 hover:text-white'
      }`;

      if (isVideo) {
        photoEl.photoUploadSection.classList.add('hidden');
        photoEl.photoWorkspaceSection.classList.add('hidden');
        photoEl.photoHeaderActions.classList.add('hidden');

        if (state.file) {
          el.uploadSection.classList.add('hidden');
          el.workspaceSection.classList.remove('hidden');
          el.headerActions.classList.remove('hidden');
        } else {
          el.uploadSection.classList.remove('hidden');
          el.workspaceSection.classList.add('hidden');
          el.headerActions.classList.add('hidden');
        }
      } else {
        el.uploadSection.classList.add('hidden');
        el.workspaceSection.classList.add('hidden');
        el.headerActions.classList.add('hidden');

        if (photoState.origImage) {
          photoEl.photoUploadSection.classList.add('hidden');
          photoEl.photoWorkspaceSection.classList.remove('hidden');
          photoEl.photoHeaderActions.classList.remove('hidden');
          schedulePhotoPreview();
        } else {
          photoEl.photoUploadSection.classList.remove('hidden');
          photoEl.photoWorkspaceSection.classList.add('hidden');
          photoEl.photoHeaderActions.classList.add('hidden');
        }
      }
    }

    photoEl.tabVideoBtn.addEventListener('click', () => switchWorkspaceTab('video'));
    photoEl.tabPhotoBtn.addEventListener('click', () => switchWorkspaceTab('photo'));

    /** Захват текущего кадра из видеоплеера и передача во вкладку «Улучшение фото» */
    photoEl.btnEnhanceVideoFrame.addEventListener('click', () => {
      if (!state.file || !el.mainVideo.videoWidth) {
        showToast('Сначала загрузите видео и дождитесь его готовности.', 'error');
        return;
      }
      try {
        el.mainVideo.pause();
        const canvas = document.createElement('canvas');
        canvas.width = el.mainVideo.videoWidth;
        canvas.height = el.mainVideo.videoHeight;
        const ctx = canvas.getContext('2d');
        ctx.drawImage(el.mainVideo, 0, 0, canvas.width, canvas.height);

        const timeTag = formatTime(el.mainVideo.currentTime).replace(/:/g, '-');
        const baseName = (state.file.name || 'video').replace(/\.[^/.]+$/, '');
        const frameName = `${baseName}_кадр_${timeTag}.png`;

        canvas.toBlob((blob) => {
          if (!blob) {
            showToast('Не удалось захватить кадр видео.', 'error');
            return;
          }
          const frameFile = new File([blob], frameName, { type: 'image/png' });
          loadPhotoFile(frameFile, true);
          switchWorkspaceTab('photo');
          showToast('Кадр видео перенесён в студию улучшения фото!', 'success');
        }, 'image/png');
      } catch (err) {
        console.error(err);
        showToast('Ошибка при захвате текущего кадра видео.', 'error');
      }
    });

    // ===================== МОДУЛЬ УЛУЧШЕНИЯ ФОТО (CLIPMIND PHOTO STUDIO) =====================

    const MAX_EXPORT_DIM = 4096; // Безопасный потолок для стабильной работы браузера

    const photoState = {
      file: null,
      objectUrl: null,
      origImage: null,
      origW: 0,
      origH: 0,
      aiImage: null,
      useAiLayer: true,
      aiPreset: 'universal',
      upscale: 1, // 1 | 2 | 4
      splitPct: 50,
      exportFormat: 'image/png',
      exportQuality: 0.92,
      isAiRunning: false,
      previewRaf: null,
      // Параметры DSP-коррекции
      dsp: {
        sharpness: 0,
        clarity: 0,
        denoise: 0,
        brightness: 0,
        contrast: 0,
        saturation: 0,
        temperature: 0,
        autoLevels: false
      }
    };

    /** Вычисление целевого разрешения с учётом выбранного апскейла */
    function getTargetPhotoDims() {
      if (!photoState.origW || !photoState.origH) return { w: 0, h: 0, capped: false };
      let w = Math.round(photoState.origW * photoState.upscale);
      let h = Math.round(photoState.origH * photoState.upscale);
      let capped = false;
      if (Math.max(w, h) > MAX_EXPORT_DIM) {
        const k = MAX_EXPORT_DIM / Math.max(w, h);
        w = Math.round(w * k);
        h = Math.round(h * k);
        capped = true;
      }
      return { w, h, capped };
    }

    /** Обновление бейджей разрешения и подсказок */
    function updatePhotoResolutionBadges() {
      const { w, h, capped } = getTargetPhotoDims();
      photoEl.photoResOriginal.textContent = `${photoState.origW}×${photoState.origH}`;
      photoEl.photoResTarget.textContent = `${w}×${h}`;
      photoEl.exportPhotoResBadge.textContent = `${w} × ${h} px`;
      if (photoState.upscale === 1) {
        photoEl.upscaleHintText.textContent = 'Оригинал (1x)';
      } else {
        photoEl.upscaleHintText.textContent = capped ? `${photoState.upscale}x (лимит ${MAX_EXPORT_DIM}px)` : `${photoState.upscale}x → ${w}×${h}`;
      }
    }

    /** Загрузка выбранного файла изображения */
    function loadPhotoFile(file, silent = false) {
      if (!file) return;
      if (!file.type.startsWith('image/')) {
        showToast('Пожалуйста, выберите изображение (JPG, PNG, WebP).', 'error');
        return;
      }

      if (photoState.objectUrl) {
        URL.revokeObjectURL(photoState.objectUrl);
      }

      const url = URL.createObjectURL(file);
      const img = new Image();
      img.onload = () => {
        photoState.file = file;
        photoState.objectUrl = url;
        photoState.origImage = img;
        photoState.origW = img.naturalWidth;
        photoState.origH = img.naturalHeight;
        photoState.aiImage = null;
        photoState.useAiLayer = false;
        photoState.upscale = 1;
        photoState.splitPct = 50;

        resetDspSliders(false);
        setUpscaleUI(1);
        updateCompareSplit(50);

        // Заполняем метаданные
        const extLabel = (file.type.split('/')[1] || 'IMG').toUpperCase().replace('JPEG', 'JPG');
        photoEl.photoMetaName.textContent = file.name;
        photoEl.photoMetaFormat.textContent = extLabel;
        photoEl.photoMetaSize.textContent = formatFileSize(file.size);
        photoEl.photoBeforeImg.src = url;

        // Скрываем прошлый отчёт ИИ
        photoEl.photoAiReportCard.classList.add('hidden');
        photoEl.photoAiActiveBadge.classList.add('hidden');
        photoEl.aiLayerToggleWrap.classList.add('hidden');
        photoEl.chkUseAiLayer.checked = true;

        updatePhotoResolutionBadges();

        if (activeWorkspaceTab === 'photo') {
          photoEl.photoUploadSection.classList.add('hidden');
          photoEl.photoWorkspaceSection.classList.remove('hidden');
          photoEl.photoHeaderActions.classList.remove('hidden');
        }

        schedulePhotoPreview();
        if (!silent) {
          showToast(`Фото «${file.name}» загружено (${img.naturalWidth}×${img.naturalHeight})`, 'success');
        }
      };

      img.onerror = () => {
        URL.revokeObjectURL(url);
        showToast('Не удалось открыть это изображение.', 'error');
      };

      img.src = url;
    }

    // События Drag & Drop и выбора фото
    photoEl.photoDropZone.addEventListener('click', () => photoEl.photoFileInput.click());
    photoEl.btnSelectPhoto.addEventListener('click', (e) => {
      e.stopPropagation();
      photoEl.photoFileInput.click();
    });
    photoEl.btnChangePhoto.addEventListener('click', () => photoEl.photoFileInput.click());

    photoEl.photoFileInput.addEventListener('change', (e) => {
      if (e.target.files && e.target.files[0]) {
        loadPhotoFile(e.target.files[0]);
        e.target.value = '';
      }
    });

    ['dragenter', 'dragover'].forEach(evt => {
      photoEl.photoDropZone.addEventListener(evt, (e) => {
        e.preventDefault();
        e.stopPropagation();
        photoEl.photoDropZone.classList.add('drop-active');
      });
    });

    ['dragleave', 'drop'].forEach(evt => {
      photoEl.photoDropZone.addEventListener(evt, (e) => {
        e.preventDefault();
        e.stopPropagation();
        photoEl.photoDropZone.classList.remove('drop-active');
      });
    });

    photoEl.photoDropZone.addEventListener('drop', (e) => {
      const files = e.dataTransfer?.files;
      if (files && files[0]) {
        loadPhotoFile(files[0]);
      }
    });

    // ===================== ШТОРКА СРАВНЕНИЯ «ДО / ПОСЛЕ» =====================

    function updateCompareSplit(pct) {
      const clamped = Math.max(0, Math.min(100, pct));
      photoState.splitPct = clamped;
      photoEl.compareBeforeClip.style.clipPath = `inset(0 ${100 - clamped}% 0 0)`;
      photoEl.compareDivider.style.left = `${clamped}%`;
    }

    let isDraggingSplit = false;

    function handleSplitPointer(clientX) {
      const rect = photoEl.compareStage.getBoundingClientRect();
      if (!rect.width) return;
      const pct = ((clientX - rect.left) / rect.width) * 100;
      updateCompareSplit(pct);
    }

    photoEl.compareStage.addEventListener('mousedown', (e) => {
      isDraggingSplit = true;
      handleSplitPointer(e.clientX);
    });
    window.addEventListener('mousemove', (e) => {
      if (!isDraggingSplit) return;
      handleSplitPointer(e.clientX);
    });
    window.addEventListener('mouseup', () => {
      isDraggingSplit = false;
    });

    photoEl.compareStage.addEventListener('touchstart', (e) => {
      if (e.touches && e.touches[0]) {
        isDraggingSplit = true;
        handleSplitPointer(e.touches[0].clientX);
      }
    }, { passive: true });
    window.addEventListener('touchmove', (e) => {
      if (!isDraggingSplit || !e.touches || !e.touches[0]) return;
      handleSplitPointer(e.touches[0].clientX);
    }, { passive: true });
    window.addEventListener('touchend', () => {
      isDraggingSplit = false;
    });

    // ===================== ДВИЖОК СТУДИЙНОЙ ОБРАБОТКИ (CANVAS DSP) =====================

    function clampByte(v) {
      return v < 0 ? 0 : (v > 255 ? 255 : v);
    }

    /**
     * Многоступенчатое качественное масштабирование изображения на canvas
     */
    function drawHighQualityScaled(sourceImg, targetW, targetH) {
      const srcW = sourceImg.naturalWidth || sourceImg.width;
      const srcH = sourceImg.naturalHeight || sourceImg.height;

      const outCanvas = document.createElement('canvas');
      outCanvas.width = targetW;
      outCanvas.height = targetH;
      const outCtx = outCanvas.getContext('2d', { willReadFrequently: true });
      outCtx.imageSmoothingEnabled = true;
      outCtx.imageSmoothingQuality = 'high';

      // При увеличении > 2x делаем промежуточный шаг для более плавных контуров
      if (targetW > srcW * 2.1) {
        const midCanvas = document.createElement('canvas');
        midCanvas.width = Math.round(srcW * 2);
        midCanvas.height = Math.round(srcH * 2);
        const midCtx = midCanvas.getContext('2d');
        midCtx.imageSmoothingEnabled = true;
        midCtx.imageSmoothingQuality = 'high';
        midCtx.drawImage(sourceImg, 0, 0, midCanvas.width, midCanvas.height);
        outCtx.drawImage(midCanvas, 0, 0, targetW, targetH);
      } else {
        outCtx.drawImage(sourceImg, 0, 0, targetW, targetH);
      }
      return outCanvas;
    }

    /**
     * Применяет полный конвейер DSP-фильтров к переданному ImageData
     */
    function applyDspPipeline(imageData, dsp, upscaleBoost = 0) {
      const { width: w, height: h, data } = imageData;
      const len = data.length;

      // 1. Авто-уровни (мягкое растяжение гистограммы 1%..99%)
      if (dsp.autoLevels) {
        const histR = new Uint32Array(256);
        const histG = new Uint32Array(256);
        const histB = new Uint32Array(256);
        const step = Math.max(1, Math.floor((w * h) / 40000));
        let samples = 0;
        for (let i = 0; i < len; i += 4 * step) {
          histR[data[i]]++;
          histG[data[i + 1]]++;
          histB[data[i + 2]]++;
          samples++;
        }
        const findBounds = (hist) => {
          const lowT = samples * 0.01;
          const highT = samples * 0.99;
          let acc = 0, lo = 0, hi = 255;
          for (let v = 0; v < 256; v++) {
            acc += hist[v];
            if (acc >= lowT) { lo = v; break; }
          }
          acc = 0;
          for (let v = 255; v >= 0; v--) {
            acc += hist[v];
            if (acc >= samples - highT) { hi = v; break; }
          }
          return [lo, Math.max(lo + 10, hi)];
        };
        const [rLo, rHi] = findBounds(histR);
        const [gLo, gHi] = findBounds(histG);
        const [bLo, bHi] = findBounds(histB);
        const rScale = 255 / (rHi - rLo);
        const gScale = 255 / (gHi - gLo);
        const bScale = 255 / (bHi - bLo);
        const mix = 0.78;

        for (let i = 0; i < len; i += 4) {
          data[i] = clampByte(data[i] * (1 - mix) + ((data[i] - rLo) * rScale) * mix);
          data[i + 1] = clampByte(data[i + 1] * (1 - mix) + ((data[i + 1] - gLo) * gScale) * mix);
          data[i + 2] = clampByte(data[i + 2] * (1 - mix) + ((data[i + 2] - bLo) * bScale) * mix);
        }
      }

      // 2. Шумоподавление (быстрый краесохраняющий 3x3 фильтр)
      if (dsp.denoise > 0) {
        const src = new Uint8ClampedArray(data);
        const strength = (dsp.denoise / 100) * 0.85;
        const threshold = 16 + (dsp.denoise / 100) * 34;

        for (let y = 1; y < h - 1; y++) {
          const row = y * w;
          for (let x = 1; x < w - 1; x++) {
            const idx = (row + x) * 4;
            const cr = src[idx], cg = src[idx + 1], cb = src[idx + 2];
            let sr = cr, sg = cg, sb = cb, weightSum = 1;

            for (let dy = -1; dy <= 1; dy++) {
              const nrow = (y + dy) * w;
              for (let dx = -1; dx <= 1; dx++) {
                if (dx === 0 && dy === 0) continue;
                const nidx = (nrow + x + dx) * 4;
                const nr = src[nidx], ng = src[nidx + 1], nb = src[nidx + 2];
                const diff = (Math.abs(nr - cr) + Math.abs(ng - cg) + Math.abs(nb - cb)) * 0.333;
                if (diff < threshold) {
                  const wt = 1 - diff / threshold;
                  sr += nr * wt;
                  sg += ng * wt;
                  sb += nb * wt;
                  weightSum += wt;
                }
              }
            }

            data[idx] = clampByte(cr * (1 - strength) + (sr / weightSum) * strength);
            data[idx + 1] = clampByte(cg * (1 - strength) + (sg / weightSum) * strength);
            data[idx + 2] = clampByte(cb * (1 - strength) + (sb / weightSum) * strength);
          }
        }
      }

      // 3. Яркость, Контраст, Температура, Насыщенность (единый проход)
      const hasColorAdjust =
        dsp.brightness !== 0 ||
        dsp.contrast !== 0 ||
        dsp.saturation !== 0 ||
        dsp.temperature !== 0;

      if (hasColorAdjust) {
        const br = dsp.brightness * 1.45;
        const cVal = dsp.contrast * 1.8;
        const cFactor = (259 * (cVal + 255)) / (255 * (259 - cVal));
        const satFactor = 1 + dsp.saturation / 100;
        const tR = dsp.temperature * 0.7;
        const tG = dsp.temperature * 0.12;
        const tB = -dsp.temperature * 0.7;

        for (let i = 0; i < len; i += 4) {
          let r = data[i] + tR + br;
          let g = data[i + 1] + tG + br;
          let b = data[i + 2] + tB + br;

          if (dsp.contrast !== 0) {
            r = cFactor * (r - 128) + 128;
            g = cFactor * (g - 128) + 128;
            b = cFactor * (b - 128) + 128;
          }

          if (dsp.saturation !== 0) {
            const lum = 0.2126 * r + 0.7152 * g + 0.0722 * b;
            r = lum + (r - lum) * satFactor;
            g = lum + (g - lum) * satFactor;
            b = lum + (b - lum) * satFactor;
          }

          data[i] = clampByte(r);
          data[i + 1] = clampByte(g);
          data[i + 2] = clampByte(b);
        }
      }

      // 4. Чёткость (локальный контраст средних тонов) + Резкость (Unsharp Mask)
      const effectiveSharp = Math.min(125, dsp.sharpness + upscaleBoost);
      if (effectiveSharp > 0 || dsp.clarity !== 0) {
        const src = new Uint8ClampedArray(data);
        const sharpAmt = (effectiveSharp / 100) * 1.45;
        const clarityAmt = (dsp.clarity / 100) * 0.9;

        for (let y = 1; y < h - 1; y++) {
          const row = y * w;
          const up = (y - 1) * w;
          const dn = (y + 1) * w;

          for (let x = 1; x < w - 1; x++) {
            const idx = (row + x) * 4;
            const iL = (row + x - 1) * 4;
            const iR = (row + x + 1) * 4;
            const iU = (up + x) * 4;
            const iD = (dn + x) * 4;

            for (let c = 0; c < 3; c++) {
              const center = src[idx + c];
              // Мягкое 3x3 размытие (крест + центр)
              const blur = (center * 4 + src[iL + c] + src[iR + c] + src[iU + c] + src[iD + c]) * 0.125;
              const diff = center - blur;

              let val = center;
              if (sharpAmt > 0 && Math.abs(diff) > 1.2) {
                val += diff * sharpAmt;
              }
              if (clarityAmt !== 0) {
                const norm = center / 255;
                const midWeight = 4 * norm * (1 - norm); // Пик в средних тонах
                val += diff * clarityAmt * (0.4 + midWeight);
              }
              data[idx + c] = clampByte(val);
            }
          }
        }
      }

      return imageData;
    }

    /** Отрисовка быстрого предпросмотра в реальном времени на #photoAfterCanvas */
    function renderPhotoPreview() {
      if (!photoState.origImage) return;

      const sourceImg = (photoState.aiImage && photoState.useAiLayer) ? photoState.aiImage : photoState.origImage;
      const maxPreview = 1050;
      const scale = Math.min(1, maxPreview / Math.max(photoState.origW, photoState.origH));
      const pw = Math.max(1, Math.round(photoState.origW * scale));
      const ph = Math.max(1, Math.round(photoState.origH * scale));

      const canvas = photoEl.photoAfterCanvas;
      if (canvas.width !== pw || canvas.height !== ph) {
        canvas.width = pw;
        canvas.height = ph;
      }

      const ctx = canvas.getContext('2d', { willReadFrequently: true });
      ctx.imageSmoothingEnabled = true;
      ctx.imageSmoothingQuality = 'high';
      ctx.drawImage(sourceImg, 0, 0, pw, ph);

      const upscaleBoost = photoState.upscale === 4 ? 18 : (photoState.upscale === 2 ? 10 : 0);
      const needsDsp =
        photoState.dsp.autoLevels ||
        photoState.dsp.sharpness > 0 ||
        photoState.dsp.clarity !== 0 ||
        photoState.dsp.denoise > 0 ||
        photoState.dsp.brightness !== 0 ||
        photoState.dsp.contrast !== 0 ||
        photoState.dsp.saturation !== 0 ||
        photoState.dsp.temperature !== 0 ||
        upscaleBoost > 0;

      if (needsDsp) {
        const imgData = ctx.getImageData(0, 0, pw, ph);
        applyDspPipeline(imgData, photoState.dsp, upscaleBoost);
        ctx.putImageData(imgData, 0, 0);
      }
    }

    function schedulePhotoPreview() {
      if (photoState.previewRaf) cancelAnimationFrame(photoState.previewRaf);
      photoState.previewRaf = requestAnimationFrame(() => {
        photoState.previewRaf = null;
        renderPhotoPreview();
      });
    }

    // ===================== УПРАВЛЕНИЕ ПОЛЗУНКАМИ, ПРЕСЕТАМИ И АПСКЕЙЛОМ =====================

    function syncDspUI() {
      const d = photoState.dsp;
      photoEl.rngSharpness.value = d.sharpness;
      photoEl.rngClarity.value = d.clarity;
      photoEl.rngDenoise.value = d.denoise;
      photoEl.rngBrightness.value = d.brightness;
      photoEl.rngContrast.value = d.contrast;
      photoEl.rngSaturation.value = d.saturation;
      photoEl.rngTemperature.value = d.temperature;
      photoEl.chkAutoLevels.checked = d.autoLevels;

      photoEl.valSharpness.textContent = d.sharpness;
      photoEl.valClarity.textContent = d.clarity > 0 ? `+${d.clarity}` : d.clarity;
      photoEl.valDenoise.textContent = d.denoise;
      photoEl.valBrightness.textContent = d.brightness > 0 ? `+${d.brightness}` : d.brightness;
      photoEl.valContrast.textContent = d.contrast > 0 ? `+${d.contrast}` : d.contrast;
      photoEl.valSaturation.textContent = d.saturation > 0 ? `+${d.saturation}` : d.saturation;
      photoEl.valTemperature.textContent = d.temperature > 0 ? `+${d.temperature}` : d.temperature;
    }

    function resetDspSliders(redraw = true) {
      photoState.dsp = {
        sharpness: 0,
        clarity: 0,
        denoise: 0,
        brightness: 0,
        contrast: 0,
        saturation: 0,
        temperature: 0,
        autoLevels: false
      };
      syncDspUI();
      if (redraw) schedulePhotoPreview();
    }

    function setUpscaleUI(scaleVal) {
      photoState.upscale = scaleVal;
      photoEl.upscaleBtns.forEach(btn => {
        const active = Number(btn.dataset.scale) === scaleVal;
        btn.classList.toggle('active', active);
        btn.classList.toggle('border-indigo-500/60', active);
        btn.classList.toggle('bg-indigo-500/20', active);
        btn.classList.toggle('text-white', active);
        btn.classList.toggle('border-white/10', !active);
        btn.classList.toggle('bg-studio-950/60', !active);
        btn.classList.toggle('text-zinc-300', !active);
      });
      updatePhotoResolutionBadges();
      schedulePhotoPreview();
    }

    photoEl.upscaleBtns.forEach(btn => {
      btn.addEventListener('click', () => setUpscaleUI(Number(btn.dataset.scale)));
    });

    // Привязка ползунков
    const sliderBindings = [
      ['rngSharpness', 'sharpness'],
      ['rngClarity', 'clarity'],
      ['rngDenoise', 'denoise'],
      ['rngBrightness', 'brightness'],
      ['rngContrast', 'contrast'],
      ['rngSaturation', 'saturation'],
      ['rngTemperature', 'temperature']
    ];
    sliderBindings.forEach(([elKey, prop]) => {
      photoEl[elKey].addEventListener('input', (e) => {
        photoState.dsp[prop] = Number(e.target.value);
        syncDspUI();
        schedulePhotoPreview();
      });
    });

    photoEl.chkAutoLevels.addEventListener('change', (e) => {
      photoState.dsp.autoLevels = e.target.checked;
      schedulePhotoPreview();
    });

    // Быстрые DSP-пресеты
    const DSP_PRESETS = {
      crisp: { sharpness: 48, clarity: 32, denoise: 12, brightness: 4, contrast: 14, saturation: 10, temperature: 0, autoLevels: true },
      cinema: { sharpness: 22, clarity: 24, denoise: 10, brightness: -4, contrast: 20, saturation: -8, temperature: 12, autoLevels: false },
      soft: { sharpness: 12, clarity: -10, denoise: 28, brightness: 14, contrast: -6, saturation: 8, temperature: 6, autoLevels: false },
      reset: { sharpness: 0, clarity: 0, denoise: 0, brightness: 0, contrast: 0, saturation: 0, temperature: 0, autoLevels: false }
    };

    photoEl.dspPresetBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const key = btn.dataset.dspPreset;
        if (!DSP_PRESETS[key]) return;
        photoState.dsp = { ...DSP_PRESETS[key] };
        if (key === 'crisp' && photoState.upscale === 1) {
          setUpscaleUI(2);
        }
        syncDspUI();
        schedulePhotoPreview();
        showToast(key === 'reset' ? 'Коррекция сброшена' : `Применён пресет «${btn.textContent.trim()}»`, 'info');
      });
    });

    // Полный сброс фото
    photoEl.btnResetPhotoAll.addEventListener('click', () => {
      photoState.aiImage = null;
      photoState.useAiLayer = false;
      photoEl.photoAiActiveBadge.classList.add('hidden');
      photoEl.aiLayerToggleWrap.classList.add('hidden');
      photoEl.photoAiReportCard.classList.add('hidden');
      setUpscaleUI(1);
      resetDspSliders(true);
      updateCompareSplit(50);
      showToast('Все улучшения сброшены к оригиналу', 'info');
    });

    // Переключатель ИИ-слоя
    photoEl.chkUseAiLayer.addEventListener('change', (e) => {
      photoState.useAiLayer = e.target.checked;
      photoEl.photoAiActiveBadge.classList.toggle('hidden', !(photoState.aiImage && photoState.useAiLayer));
      schedulePhotoPreview();
    });

    // Выбор ИИ-пресета
    photoEl.aiPhotoPresetBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        photoEl.aiPhotoPresetBtns.forEach(b => {
          b.classList.remove('active', 'border-purple-500/60', 'bg-purple-500/15', 'text-white');
          b.classList.add('border-white/10', 'bg-studio-950/60', 'text-zinc-300');
        });
        btn.classList.add('active', 'border-purple-500/60', 'bg-purple-500/15', 'text-white');
        btn.classList.remove('border-white/10', 'bg-studio-950/60', 'text-zinc-300');
        photoState.aiPreset = btn.dataset.preset;
      });
    });

    // ===================== ИИ-УЛУЧШЕНИЕ ФОТО (GEMINI API) =====================

    /** Готовит base64-версию исходного фото для отправки в Gemini */
    function getPhotoBase64ForApi(maxSide = 1280) {
      const scale = Math.min(1, maxSide / Math.max(photoState.origW, photoState.origH));
      const c = document.createElement('canvas');
      c.width = Math.max(1, Math.round(photoState.origW * scale));
      c.height = Math.max(1, Math.round(photoState.origH * scale));
      const ctx = c.getContext('2d');
      ctx.imageSmoothingEnabled = true;
      ctx.imageSmoothingQuality = 'high';
      ctx.drawImage(photoState.origImage, 0, 0, c.width, c.height);
      const dataUrl = c.toDataURL('image/jpeg', 0.9);
      return { mimeType: 'image/jpeg', data: dataUrl.split(',')[1] };
    }

    /** Генеративное улучшение/реставрация изображения через Gemini Image */
    async function tryGenerativePhotoEnhance(inlineImg, presetPrompt, customNote) {
      const fullPrompt = `Enhance and restore this photograph to professional studio quality while strictly preserving the exact composition, subjects, faces, poses, text, and framing. Do not add or remove objects.
Task: ${presetPrompt}${customNote ? `\nAdditional user request: ${customNote}` : ''}
Output a clean, sharp, high-definition restored photograph.`;

      const payload = {
        contents: [{
          role: 'user',
          parts: [
            { text: fullPrompt },
            { inlineData: inlineImg }
          ]
        }],
        generationConfig: {
          responseModalities: ['TEXT', 'IMAGE']
        }
      };

      const modelsToTry = [GEMINI_IMAGE_MODEL, GEMINI_IMAGE_FALLBACK];
      for (const modelName of modelsToTry) {
        try {
          const url = `https://generativelanguage.googleapis.com/v1beta/models/${modelName}:generateContent?key=${apiKey}`;
          const res = await fetch(url, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
          });
          if (!res.ok) continue;
          const json = await res.json();
          const imgPart = json?.candidates?.[0]?.content?.parts?.find(p => p.inlineData?.data);
          if (imgPart) {
            return `data:${imgPart.inlineData.mimeType || 'image/png'};base64,${imgPart.inlineData.data}`;
          }
        } catch (e) {
          // Пробуем следующую модель или переходим к DSP-анализу
        }
      }
      return null;
    }

    /** ИИ-анализ фото через Gemini Vision с подбором оптимальных параметров DSP и отчётом */
    async function runAiPhotoAnalysis(inlineImg, presetLabel, customNote) {
      const payload = {
        contents: [{
          role: 'user',
          parts: [
            {
              text: `Проанализируй это фото (режим: «${presetLabel}»${customNote ? `, пожелание: «${customNote}»` : ''}).
Оцени экспозицию, резкость, баланс белого и уровень шума. Подбери оптимальные числовые параметры студийной обработки (Canvas DSP) и напиши краткий понятный отчёт на русском языке, что именно было улучшено.`
            },
            { inlineData: inlineImg }
          ]
        }],
        generationConfig: {
          responseMimeType: 'application/json',
          responseSchema: {
            type: 'OBJECT',
            properties: {
              summary: { type: 'STRING', description: 'Краткий отчёт на русском (2-3 предложения), что было обнаружено и улучшено' },
              exposureStatus: { type: 'STRING', description: 'Краткая оценка экспозиции (1-3 слова)' },
              sharpnessStatus: { type: 'STRING', description: 'Краткая оценка резкости (1-3 слова)' },
              whiteBalanceStatus: { type: 'STRING', description: 'Краткая оценка баланса белого (1-3 слова)' },
              noiseStatus: { type: 'STRING', description: 'Краткая оценка шума (1-3 слова)' },
              recommendedDsp: {
                type: 'OBJECT',
                properties: {
                  sharpness: { type: 'NUMBER', description: 'От 0 до 80' },
                  clarity: { type: 'NUMBER', description: 'От -20 до 60' },
                  denoise: { type: 'NUMBER', description: 'От 0 до 60' },
                  brightness: { type: 'NUMBER', description: 'От -25 до 25' },
                  contrast: { type: 'NUMBER', description: 'От -20 до 30' },
                  saturation: { type: 'NUMBER', description: 'От -25 до 35' },
                  temperature: { type: 'NUMBER', description: 'От -25 до 25' },
                  autoLevels: { type: 'BOOLEAN' }
                },
                required: ['sharpness', 'clarity', 'denoise', 'brightness', 'contrast', 'saturation', 'temperature', 'autoLevels']
              }
            },
            required: ['summary', 'exposureStatus', 'sharpnessStatus', 'whiteBalanceStatus', 'noiseStatus', 'recommendedDsp']
          }
        }
      };

      const result = await callGeminiWithRetry(payload, 2);
      const raw = result?.candidates?.[0]?.content?.parts?.[0]?.text;
      return raw ? JSON.parse(raw) : null;
    }

    /** Запуск полного ИИ-улучшения фото */
    photoEl.btnRunPhotoAi.addEventListener('click', async () => {
      if (!photoState.origImage || photoState.isAiRunning) return;

      const presetConfigs = {
        universal: { label: 'Универсальное улучшение', prompt: 'Balance exposure, improve micro-contrast, sharpen natural details, remove compression artifacts, and produce vivid natural colors.' },
        portrait: { label: 'Портрет и детали лица', prompt: 'Enhance portrait clarity, crisp eye and hair details, natural skin texture without plastic over-smoothing, and flattering soft studio lighting.' },
        denoise: { label: 'Убрать шум и размытие', prompt: 'Aggressively remove digital ISO noise, grain, JPEG artifacts, and motion/focus blur while reconstructing sharp natural edges.' },
        restore: { label: 'Восстановление старого фото', prompt: 'Restore an old or damaged photograph: repair scratches, dust, fading, and low contrast, enhance clarity and natural lifelike tones.' },
        hdr: { label: 'HDR и сочные цвета', prompt: 'Create a balanced HDR look: recover shadow and highlight details, boost local micro-contrast, and enrich colors cleanly without oversaturation.' }
      };

      const cfg = presetConfigs[photoState.aiPreset] || presetConfigs.universal;
      const customNote = photoEl.photoAiCustomPrompt.value.trim();

      photoState.isAiRunning = true;
      photoEl.btnRunPhotoAi.disabled = true;
      photoEl.btnRunPhotoAiText.textContent = 'ИИ работает...';
      photoEl.photoProcessingOverlay.classList.remove('hidden');
      photoEl.photoProcessingTitle.textContent = `ИИ-улучшение: ${cfg.label}`;
      photoEl.photoProcessingSub.textContent = 'Выполняем реставрацию деталей и анализ кадра через Gemini...';

      try {
        const inlineImg = getPhotoBase64ForApi(1280);

        // Запускаем генеративную реставрацию и ИИ-анализ параллельно
        const [genDataUrl, analysis] = await Promise.all([
          tryGenerativePhotoEnhance(inlineImg, cfg.prompt, customNote),
          runAiPhotoAnalysis(inlineImg, cfg.label, customNote).catch(() => null)
        ]);

        let usedGenerative = false;

        if (genDataUrl) {
          await new Promise((resolve, reject) => {
            const aiImg = new Image();
            aiImg.onload = () => {
              photoState.aiImage = aiImg;
              photoState.useAiLayer = true;
              usedGenerative = true;
              resolve();
            };
            aiImg.onerror = reject;
            aiImg.src = genDataUrl;
          });

          photoEl.photoAiActiveBadge.classList.remove('hidden');
          photoEl.aiLayerToggleWrap.classList.remove('hidden');
          photoEl.chkUseAiLayer.checked = true;
          // При наличии готового ИИ-слоя оставляем DSP на нуле, чтобы пользователь мог докрутить вручную
          resetDspSliders(false);
        } else if (analysis && analysis.recommendedDsp) {
          // Надёжный fallback: применяем точные параметры DSP от Gemini Vision
          const rec = analysis.recommendedDsp;
          photoState.dsp = {
            sharpness: Math.max(0, Math.min(100, Math.round(rec.sharpness || 25))),
            clarity: Math.max(-50, Math.min(100, Math.round(rec.clarity || 18))),
            denoise: Math.max(0, Math.min(100, Math.round(rec.denoise || 12))),
            brightness: Math.max(-50, Math.min(50, Math.round(rec.brightness || 0))),
            contrast: Math.max(-50, Math.min(50, Math.round(rec.contrast || 10))),
            saturation: Math.max(-100, Math.min(100, Math.round(rec.saturation || 8))),
            temperature: Math.max(-50, Math.min(50, Math.round(rec.temperature || 0))),
            autoLevels: Boolean(rec.autoLevels)
          };
          syncDspUI();
        } else {
          // Резервный пресет, если оба сетевых вызова недоступны
          photoState.dsp = { ...DSP_PRESETS.crisp };
          syncDspUI();
        }

        // Отображаем отчёт ИИ
        photoEl.photoAiReportCard.classList.remove('hidden');
        photoEl.photoAiMethodNote.textContent = usedGenerative
          ? `Режим: «${cfg.label}» • Генеративная ИИ-реставрация + анализ Gemini`
          : `Режим: «${cfg.label}» • Автоматическая ИИ-калибровка DSP Gemini`;

        photoEl.photoAiSummaryText.textContent = analysis?.summary ||
          'Выполнено интеллектуальное повышение детализации, выравнивание света, контраста и подавление цифрового шума.';

        const metrics = [
          { label: 'Экспозиция', value: analysis?.exposureStatus || 'Сбалансирована' },
          { label: 'Резкость', value: analysis?.sharpnessStatus || 'Повышена' },
          { label: 'Баланс белого', value: analysis?.whiteBalanceStatus || 'Оптимальный' },
          { label: 'Шум', value: analysis?.noiseStatus || 'Подавлен' }
        ];
        photoEl.photoAiMetricsGrid.innerHTML = metrics.map(m => `
          <div class="rounded-xl bg-studio-950/80 border border-white/8 px-3 py-2">
            <div class="text-[10px] uppercase tracking-wider text-zinc-500 mb-0.5">${escapeHtml(m.label)}</div>
            <div class="text-xs font-semibold text-zinc-200 truncate">${escapeHtml(m.value)}</div>
          </div>
        `).join('');

        schedulePhotoPreview();
        showToast(usedGenerative ? 'ИИ-реставрация фото успешно завершена!' : 'ИИ подобрал оптимальные параметры улучшения!', 'success');

      } catch (err) {
        console.error(err);
        showToast('Не удалось выполнить ИИ-улучшение. Попробуйте ещё раз.', 'error');
      } finally {
        photoState.isAiRunning = false;
        photoEl.btnRunPhotoAi.disabled = false;
        photoEl.btnRunPhotoAiText.textContent = 'Улучшить с помощью ИИ';
        photoEl.photoProcessingOverlay.classList.add('hidden');
      }
    });

    // ===================== ЭКСПОРТ УЛУЧШЕННОГО ФОТО =====================

    photoEl.photoFmtBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        photoEl.photoFmtBtns.forEach(b => {
          b.classList.remove('active', 'border-indigo-500/60', 'bg-indigo-500/20', 'text-white');
          b.classList.add('border-white/10', 'bg-studio-950/60', 'text-zinc-300');
        });
        btn.classList.add('active', 'border-indigo-500/60', 'bg-indigo-500/20', 'text-white');
        btn.classList.remove('border-white/10', 'bg-studio-950/60', 'text-zinc-300');

        photoState.exportFormat = btn.dataset.fmt;
        photoEl.photoQualityWrap.classList.toggle('hidden', photoState.exportFormat === 'image/png');
      });
    });

    photoEl.rngPhotoQuality.addEventListener('input', (e) => {
      const q = Number(e.target.value);
      photoState.exportQuality = q / 100;
      photoEl.valPhotoQuality.textContent = `${q}%`;
    });

    async function exportEnhancedPhoto() {
      if (!photoState.origImage) return;

      photoEl.btnDownloadEnhancedPhoto.disabled = true;
      photoEl.btnDownloadPhotoText.textContent = 'Рендеринг в высоком разрешении...';

      // Даём браузеру отрисовать состояние кнопки перед тяжёлым рендером
      await new Promise(r => setTimeout(r, 40));

      try {
        const { w, h } = getTargetPhotoDims();
        const sourceImg = (photoState.aiImage && photoState.useAiLayer) ? photoState.aiImage : photoState.origImage;

        const outCanvas = drawHighQualityScaled(sourceImg, w, h);
        const ctx = outCanvas.getContext('2d', { willReadFrequently: true });

        const upscaleBoost = photoState.upscale === 4 ? 18 : (photoState.upscale === 2 ? 10 : 0);
        const needsDsp =
          photoState.dsp.autoLevels ||
          photoState.dsp.sharpness > 0 ||
          photoState.dsp.clarity !== 0 ||
          photoState.dsp.denoise > 0 ||
          photoState.dsp.brightness !== 0 ||
          photoState.dsp.contrast !== 0 ||
          photoState.dsp.saturation !== 0 ||
          photoState.dsp.temperature !== 0 ||
          upscaleBoost > 0;

        if (needsDsp) {
          const imgData = ctx.getImageData(0, 0, w, h);
          applyDspPipeline(imgData, photoState.dsp, upscaleBoost);
          ctx.putImageData(imgData, 0, 0);
        }

        const extMap = { 'image/png': 'png', 'image/jpeg': 'jpg', 'image/webp': 'webp' };
        const ext = extMap[photoState.exportFormat] || 'png';
        const baseName = (photoState.file?.name || 'photo').replace(/\.[^/.]+$/, '');
        const scaleTag = photoState.upscale > 1 ? `_${photoState.upscale}x` : '';

        await new Promise((resolve, reject) => {
          outCanvas.toBlob((blob) => {
            if (!blob) {
              reject(new Error('Не удалось сформировать файл изображения'));
              return;
            }
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = `${baseName}_enhanced${scaleTag}.${ext}`;
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            setTimeout(() => URL.revokeObjectURL(url), 4000);
            resolve();
          }, photoState.exportFormat, photoState.exportQuality);
        });

        showToast(`Улучшенное фото (${w}×${h}) скачано!`, 'success');
      } catch (err) {
        console.error(err);
        showToast('Ошибка при экспорте фото. Попробуйте уменьшить масштаб апскейла.', 'error');
      } finally {
        photoEl.btnDownloadEnhancedPhoto.disabled = false;
        photoEl.btnDownloadPhotoText.textContent = 'Скачать улучшенное фото';
      }
    }

    photoEl.btnDownloadEnhancedPhoto.addEventListener('click', exportEnhancedPhoto);
    photoEl.btnQuickDownloadPhoto.addEventListener('click', exportEnhancedPhoto);
  </script>
</body>
