      const start = parseTimeInput(el.editSegStart.value);
      const end = parseTimeInput(el.editSegEnd.value);
      const category = el.editSegCategory.value.trim() || 'Сцена';
      const summary = el.editSegSummary.value.trim();
      const tags = el.editSegTags.value.split(',').map(t => t.replace(/^#/, '').trim()).filter(Boolean).slice(0, 5);

      if (isNaN(start) || isNaN(end) || start < 0 || end <= start || (state.duration && end > state.duration + 0.5)) {
        showToast('Проверьте таймкоды: конец должен быть больше начала и в пределах длины видео.', 'error');
        return;
      }

      const clampedEnd = state.duration ? Math.min(state.duration, end) : end;

      if (id) {
        const target = state.segments.find(s => s.id === id);
        if (target) {
          target.title = title;
          target.start = Number(start.toFixed(1));
          target.end = Number(clampedEnd.toFixed(1));
          target.category = category;
          target.summary = summary;
          target.tags = tags;
        }
        showToast('Фрагмент обновлён', 'success');
      } else {
        state.segments.push({
          id: uid(),
          title,
          start: Number(start.toFixed(1)),
          end: Number(clampedEnd.toFixed(1)),
          category,
          summary,
          tags,
          colorIdx: state.segments.length % SEGMENT_COLORS.length
        });
        showToast('Фрагмент добавлен', 'success');
      }

      state.segments.sort((a, b) => a.start - b.start);
      closeEditModal();
      renderAll();
    });

