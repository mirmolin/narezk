    // ===================== РЕАЛЬНАЯ НАРЕЗКА И СКАЧИВАНИЕ ВИДЕО =====================

    function getBestRecorderOptions() {
      const candidates = [
        { mimeType: 'video/webm;codecs=vp9,opus', ext: 'webm' },
        { mimeType: 'video/webm;codecs=vp8,opus', ext: 'webm' },
        { mimeType: 'video/webm', ext: 'webm' },
        { mimeType: 'video/mp4', ext: 'mp4' }
      ];
      for (const c of candidates) {
        if (typeof MediaRecorder !== 'undefined' && MediaRecorder.isTypeSupported(c.mimeType)) {
          return c;
        }
      }
      return { mimeType: '', ext: 'webm' };
    }

    /**
     * Записывает выбранный отрезок [seg.start, seg.end] с видео и звуком через <canvas>,
     * Web Audio API и MediaRecorder, затем скачивает файл.
     */
    async function exportVideoSegment(seg, segIdx = 0) {
      if (typeof MediaRecorder === 'undefined') {
        showToast('Ваш браузер не поддерживает MediaRecorder для экспорта видео.', 'error');
        return;
      }

      el.mainVideo.pause();

      const segDuration = Math.max(0.5, seg.end - seg.start);
      el.exportSegmentName.textContent = `${seg.title} (${formatTime(seg.start)} — ${formatTime(seg.end)})`;
      el.exportProgressBar.style.width = '0%';
      el.exportPercentInfo.textContent = '0%';
      el.exportTimeInfo.textContent = `00:00 / ${formatTime(segDuration)}`;
      el.exportProgressModal.classList.remove('hidden');

      let cancelled = false;
      let animFrameId = null;
      let audioCtx = null;
      let mediaRecorder = null;

      const recVideo = document.createElement('video');
      recVideo.src = state.videoUrl;
      recVideo.crossOrigin = 'anonymous';
      recVideo.playsInline = true;
      recVideo.muted = false;
      recVideo.volume = 1.0;

      const recCanvas = document.createElement('canvas');

      const cleanup = () => {
        if (animFrameId) cancelAnimationFrame(animFrameId);
        try { recVideo.pause(); } catch (e) {}
        recVideo.src = '';
        recVideo.remove();
        if (audioCtx && audioCtx.state !== 'closed') {
          audioCtx.close().catch(() => {});
        }
        state.exportController = null;
        el.exportProgressModal.classList.add('hidden');
      };

      state.exportController = {
        cancel: () => {
          cancelled = true;
          if (mediaRecorder && mediaRecorder.state === 'recording') {
            try { mediaRecorder.stop(); } catch (e) {}
          }
          cleanup();
          showToast('Нарезка фрагмента отменена', 'info');
        }
      };

      try {
        await new Promise((resolve, reject) => {
          recVideo.onloadedmetadata = resolve;
          recVideo.onerror = () => reject(new Error('Ошибка загрузки видео для экспорта'));
        });

        await new Promise((resolve) => {
          recVideo.onseeked = resolve;
          recVideo.currentTime = seg.start;
        });

        if (cancelled) return;

        // Определяем размеры canvas (до 1280px по длинной стороне для стабильной записи)
        const srcW = recVideo.videoWidth || 1280;
        const srcH = recVideo.videoHeight || 720;
        const scale = Math.min(1, 1280 / Math.max(srcW, srcH));
        recCanvas.width = Math.max(2, Math.round((srcW * scale) / 2) * 2);
        recCanvas.height = Math.max(2, Math.round((srcH * scale) / 2) * 2);
        const ctx = recCanvas.getContext('2d');

        const canvasStream = recCanvas.captureStream(30);
        const tracks = [...canvasStream.getVideoTracks()];

        // Захват аудиодорожки через Web Audio API
        try {
          const AudioContextClass = window.AudioContext || window.webkitAudioContext;
          audioCtx = new AudioContextClass();
          if (audioCtx.state === 'suspended') {
            await audioCtx.resume();
          }
          const sourceNode = audioCtx.createMediaElementSource(recVideo);
          const destNode = audioCtx.createMediaStreamDestination();
          sourceNode.connect(destNode);
          const audioTracks = destNode.stream.getAudioTracks();
          if (audioTracks.length > 0) {
            tracks.push(...audioTracks);
          }
        } catch (audioErr) {
          // Если у видео нет звуковой дорожки — продолжаем запись видео
        }

        const combinedStream = new MediaStream(tracks);
        const { mimeType, ext } = getBestRecorderOptions();
        const recorderOpts = mimeType ? { mimeType, videoBitsPerSecond: 4000000 } : { videoBitsPerSecond: 4000000 };
        mediaRecorder = new MediaRecorder(combinedStream, recorderOpts);

        const chunks = [];
        mediaRecorder.ondataavailable = (e) => {
          if (e.data && e.data.size > 0) chunks.push(e.data);
        };

        const recordingDone = new Promise((resolve) => {
          mediaRecorder.onstop = resolve;
        });

        ctx.drawImage(recVideo, 0, 0, recCanvas.width, recCanvas.height);
        mediaRecorder.start(200);
        await recVideo.play();

        const drawLoop = () => {
          if (cancelled) return;

          ctx.drawImage(recVideo, 0, 0, recCanvas.width, recCanvas.height);
          const elapsed = Math.max(0, recVideo.currentTime - seg.start);
          const pct = Math.min(100, (elapsed / segDuration) * 100);

          el.exportProgressBar.style.width = `${pct}%`;
          el.exportPercentInfo.textContent = `${Math.round(pct)}%`;
          el.exportTimeInfo.textContent = `${formatTime(elapsed)} / ${formatTime(segDuration)}`;

          if (recVideo.currentTime >= seg.end || recVideo.ended) {
            if (mediaRecorder.state === 'recording') {
              mediaRecorder.stop();
            }
            recVideo.pause();
            return;
          }

          animFrameId = requestAnimationFrame(drawLoop);
        };

        animFrameId = requestAnimationFrame(drawLoop);

        await recordingDone;

        if (cancelled) return;

        // Сохраняем файл
        const blob = new Blob(chunks, { type: mimeType || 'video/webm' });
        const downloadUrl = URL.createObjectURL(blob);
        const safeTitle = seg.title.replace(/[\\/:*?"<>|]/g, '').replace(/\s+/g, '_').slice(0, 45) || 'fragment';
        const indexStr = String(segIdx + 1).padStart(2, '0');

        const a = document.createElement('a');
        a.href = downloadUrl;
        a.download = `${indexStr}_${safeTitle}.${ext}`;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);

        setTimeout(() => URL.revokeObjectURL(downloadUrl), 5000);
        cleanup();
        showToast(`Фрагмент «${seg.title}» успешно скачан!`, 'success');

      } catch (err) {
        console.error(err);
        if (!cancelled) {
          cleanup();
          showToast('Ошибка при нарезке видеофрагмента. Попробуйте ещё раз.', 'error');
        }
      }
    }

